{
  "name": "@zoria-lind/dsh-behavior-enhancer",
  "version": "1.2.0",
  "description": "行为管理插件:系统提示词行为约束 / 失败收敛并行度 / 连续失败用户介入 / 写后检查与 .bak 回滚,基于 DSH 真实插件 API",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "pluginType": "feature",
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.1.2",
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.5": "unknown",
        "0.1.2-rc.1": "unknown",
        "0.1.3-alpha.1": "unknown"
      }
    }
  },
  "keywords": [
    "dsh",
    "behavior",
    "parallel",
    "stability",
    "error-recovery",
    "dsh-plugin",
    "deepseek-harness"
  ]
}
